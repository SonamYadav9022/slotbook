PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/slotbook
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
CLIENT_URL=http://localhost:5173
# Offset used to interpret slot times (IST). Change for another timezone.
TZ_OFFSET=+05:30
CANCEL_WINDOW_HOURS=2

# Razorpay (use TEST mode keys: Razorpay Dashboard -> Test Mode -> Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: only needed if you add the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
# Minutes an unpaid booking holds its slot
HOLD_MINUTES=10
